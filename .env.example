# Copy this file to .env.local and fill in the values. Never commit .env.local.

# OPTIONAL. Cafe search uses OpenStreetMap for free when this is empty (no key, no billing).
# Set a Google Places API key here only if you want Google's results instead.
# Server only — no NEXT_PUBLIC_ prefix, so it never reaches the browser.
GOOGLE_MAPS_API_KEY=

# Supabase: Google sign-in + saving cafes and photos. Without these the app runs in
# browser-only preview mode. Use the publishable (sb_publishable_…) or legacy anon key —
# it is safe in the browser; Row Level Security protects the data. Never use the secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
