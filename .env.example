# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Google Maps Places API key (SERVER ONLY — no NEXT_PUBLIC_ prefix, so it never reaches the browser).
# Leave empty to use the offline example search results.
GOOGLE_MAPS_API_KEY=

# Supabase (next step: Google sign-in + saving). The anon key is safe to expose; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
